{
  "name": "@jeromefitz/websites",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for series of websites for Jerome Fitzgerald (he/him).",
  "license": "MIT",
  "author": {
    "name": "Jerome Fitzgerald",
    "email": "j@jeromefitzgerald.com",
    "url": "https://jeromefitzgerald.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeromefitz/websites"
  },
  "type": "module",
  "scripts": {
    "clean:install": "TURBO_TELEMETRY_DISABLED=1 turbo run clean && ./scripts/clean.sh",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "inspect": "pnpm node-modules-inspector",
    "lint": "oxlint .",
    "lint:ci": "oxlint . --format=github --quiet",
    "lint:fix": "oxlint --fix .",
    "lint:packages": "syncpack lint",
    "preinstall": "pnpm dlx only-allow pnpm",
    "prepare": "pnpm is-in-ci || pnpm dlx husky@9.1.7",
    "semantic-release": "pnpm run semantic-release:mono",
    "semantic-release:dry": "pnpm semantic-release:mono --dry-run",
    "semantic-release:mono": "pnpm --filter jeromefitzgerald.com -r --workspace-concurrency=1 exec -- pnpm dlx semantic-release",
    "turbo": "TURBO_TELEMETRY_DISABLED=1 turbo",
    "validate": "pnpm turbo //#quality lint:ts && pnpm run lint:packages",
    "validate:full": "pnpm turbo //#quality lint:ts test:unit && pnpm run lint:packages"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.4",
    "@jeromefitz/conventional-gitmoji": "5.2.0",
    "@jeromefitz/oxlint-config": "workspace:*",
    "@jeromefitz/release-notes-generator": "4.2.0",
    "@jeromefitz/semantic": "12.2.0",
    "@jeromefitz/tsconfig": "3.2.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.13.3",
    "ccommit": "4.2.0",
    "dotenv": "17.4.2",
    "is-in-ci": "2.0.0",
    "lodash-es": "4.18.1",
    "node-modules-inspector": "2.1.3",
    "oxfmt": "0.58.0",
    "publint": "0.3.21",
    "semantic-release": "25.0.5",
    "syncpack": "15.3.2",
    "tsdown": "0.22.4",
    "turbo": "2.10.4",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.17.0 <25"
    }
  },
  "packageManager": "pnpm@11.9.0"
}
