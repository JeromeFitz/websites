{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "paths": {
      "@/*": ["./src/*"],
      "~public/*": ["./public/*"],
      "next-config/env.client": ["./src/config/next.config.env.client.ts"],
      "next-config/env.server": ["./src/config/next.config.env.server.ts"],
      "radix-themes-tw": ["./src/config/radix-themes-tw.css"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "exclude": ["node_modules", "zzz/**"],
  "extends": "../../tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
